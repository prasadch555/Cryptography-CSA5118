#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100], key[100];
    int i, j = 0;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    printf("Enter key: ");
    scanf("%99s", key);

    for (i = 0; text[i] != '\0'; i++) {
        char c = toupper(text[i]);
        char k = toupper(key[j]);

        text[i] = ((c - 'A' + k - 'A') % 26) + 'A';

        j++;
        if (key[j] == '\0')
            j = 0;
    }

    printf("Encrypted text: %s\n", text);

    return 0;
}
